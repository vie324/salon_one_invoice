# =========================================================================
# salon_one_invoice 環境変数サンプル
# このファイルを `.env.local` にコピーして値を設定してください。
# 何も設定しない場合、アプリは「デモモード」で起動し、サンプルデータで動作します。
# =========================================================================

# --- Supabase (未設定の場合はデモモードで動作) -----------------------------
# Supabase プロジェクトの Project URL / anon key / service role key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key はサーバー側(cron/webhook)専用。クライアントに出さないこと。
SUPABASE_SERVICE_ROLE_KEY=

# --- アプリ設定 ------------------------------------------------------------
# 通貨・自社(サロン)情報の既定値。DB設定が優先されます。
NEXT_PUBLIC_APP_NAME=salon_one_invoice

# --- メール送付 (未設定の場合はコンソール出力=プレビューのみ) ---------------
# 契約書の署名依頼・請求書・代理店明細のメールを「実際に送る」ための設定。
# 方式は2通り。どちらか一方を設定すれば自動的に実送信モードになる。
#
# 【A】SMTP（Google Workspace の SMTP リレー等）— 推奨
#   MAIL_HOST を設定すると SMTP 送信になる。
#   ※ Google Workspace 側の SMTP リレー設定で「SMTP 認証が必要」を有効にすること。
#      Vercel は送信元IPが固定できないため、IP制限のみでは送信できない。
#   ※ MAIL_PASSWORD は Google の「アプリ パスワード」(16桁)を使う。
MAIL_HOST=smtp-relay.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls              # tls(587/STARTTLS) | ssl(465) | none
MAIL_USERNAME=noreply@example.jp # 空にすると SMTP 認証なし(送信元IP許可のリレー向け)
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.jp
MAIL_FROM_NAME=SalonOne

# 【B】Resend（API 送信）
#   RESEND_API_KEY を設定すると Resend 送信になる。送信元ドメインの認証(DNS)が必要。
RESEND_API_KEY=
EMAIL_FROM=                      # 例: "請求 <billing@example.jp>"（未設定なら MAIL_FROM_* を使用）

# 送信方法を明示したいとき(通常は不要): smtp | resend | console(強制的に未送信)
EMAIL_PROVIDER=

# --- 決済 / 引き落とし (未設定の場合は手動入金確認モード) -------------------
# manual: 自動引き落とし連携なし(手動/CSV照合)。 stripe: Stripe を利用。
PAYMENT_PROVIDER=manual           # manual | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- 定期請求バッチ (Vercel Cron) ------------------------------------------
# /api/cron/* を保護するシークレット。Vercel Cron の Authorization ヘッダと一致させる。
CRON_SECRET=change-me-in-production

# --- 電子契約 / 請求書の自動送付 -------------------------------------------
# 署名リンク等の絶対URL(未設定時はリクエストヘッダから推定。Vercelでは設定推奨)
NEXT_PUBLIC_APP_URL=
# 定期請求の自動生成時に請求書メールも自動送付する (true | false)
INVOICE_AUTO_EMAIL=true

# --- 申込フォームで預かる認証情報の暗号化 ------------------------------------
# お客様の HPB / minimo / EPARK の ID・パスワードは AES-256-GCM で暗号化して保存する。
# 未設定の場合は SUPABASE_SERVICE_ROLE_KEY から鍵を導出する(本番では専用鍵を推奨)。
# 生成例: openssl rand -base64 32
# ※ 変更・ローテーションすると、それ以前に保存した認証情報は復号できなくなる。
APP_ENCRYPTION_KEY=

# --- AIモック生成 (開発進捗) ------------------------------------------------
# 理想UIのワイヤーフレーム画像生成に使用。未設定時はサンプル生成のみ。
ANTHROPIC_API_KEY=
# 使用モデル(省略時: claude-opus-5)
ANTHROPIC_MODEL=
